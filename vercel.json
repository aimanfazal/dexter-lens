{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app/main.py"
    }
  },
   "rewrites": [
    {
      "source": "/generate",
      "destination": "/api/generate"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}